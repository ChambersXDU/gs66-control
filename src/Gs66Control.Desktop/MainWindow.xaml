<Window x:Class="Gs66Control.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GS66 Control" Icon="Assets/gs66-control.ico" Width="1120" Height="780" MinWidth="980" MinHeight="660" Background="#F6F6F6" Foreground="#202020" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="NativeResources.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Grid Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid Margin="16,28,16,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="14,0,0,28"><TextBlock Text="GS66" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Stealth 10SE" Style="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
      <ListBox x:Name="Navigation" Grid.Row="1" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="NavigationChanged" AutomationProperties.Name="导航">
        <ListBoxItem Tag="0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" Margin="0,0,12,0"/><TextBlock Text="概览"/></StackPanel></ListBoxItem>
        <ListBoxItem Tag="4"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9E9;" Style="{StaticResource Icon}" Margin="0,0,12,0"/><TextBlock Text="个人调优"/></StackPanel></ListBoxItem>
        <ListBoxItem Tag="3"><StackPanel Orientation="Horizontal"><Viewbox Width="16" Height="16" Margin="0,0,12,0"><Canvas Width="24" Height="24"><Ellipse Width="22" Height="22" Canvas.Left="1" Canvas.Top="1" Stroke="#202020" StrokeThickness="1.3"/><Path Fill="#202020" Data="M12,10 C6,4 12,0 17,4 C22,8 16,12 12,10"/><Path Fill="#202020" Data="M12,10 C6,4 12,0 17,4 C22,8 16,12 12,10"><Path.RenderTransform><RotateTransform Angle="120" CenterX="12" CenterY="12"/></Path.RenderTransform></Path><Path Fill="#202020" Data="M12,10 C6,4 12,0 17,4 C22,8 16,12 12,10"><Path.RenderTransform><RotateTransform Angle="240" CenterX="12" CenterY="12"/></Path.RenderTransform></Path><Ellipse Width="4" Height="4" Canvas.Left="10" Canvas.Top="10" Fill="#F6F6F6" Stroke="#202020" StrokeThickness="1"/></Canvas></Viewbox><TextBlock Text="风扇"/></StackPanel></ListBoxItem>
        <ListBoxItem Tag="1"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9E9;" Style="{StaticResource Icon}" Margin="0,0,12,0"/><TextBlock Text="方案"/></StackPanel></ListBoxItem>
        <ListBoxItem Tag="2"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource Icon}" Margin="0,0,12,0"/><TextBlock Text="设置"/></StackPanel></ListBoxItem>
      </ListBox>
      <StackPanel Grid.Row="2" Margin="14,0,0,0"><TextBlock x:Name="ConnectionText" Text="连接中" FontSize="12"/><TextBlock x:Name="StatusText" Style="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel>
    </Grid>
    <Grid Grid.Column="1" Margin="20,28,28,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,24"><Button x:Name="RefreshButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="RefreshClick" ToolTip="刷新 (F5)" AutomationProperties.Name="刷新"><TextBlock Text="&#xE72C;" Style="{StaticResource Icon}"/></Button><Button x:Name="EnableFanReadButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="EnableFanReadClick" Visibility="Collapsed" ToolTip="启用硬件读数（需要 Windows 权限）" AutomationProperties.Name="启用硬件读数"><TextBlock Text="&#xE83D;" Style="{StaticResource Icon}"/></Button><Button x:Name="RecordTuningButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="RecordTuningClick" ToolTip="记录当前方案" AutomationProperties.Name="记录当前方案"><TextBlock x:Name="RecordingGlyph" Text="●" FontSize="17" VerticalAlignment="Center"/></Button><StackPanel Orientation="Horizontal"><TextBlock x:Name="PageTitle" Text="概览" FontSize="26"/><Border x:Name="DraftBadge" Visibility="Collapsed" Background="#EAEAEA" CornerRadius="4" Padding="8,3" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="草稿" Style="{StaticResource Muted}"/></Border></StackPanel></DockPanel>
      <TabControl x:Name="Pages" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="PageChanged" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></ControlTemplate></TabControl.Template>
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="22,16"><DockPanel><Button Content="调优与切换" DockPanel.Dock="Right" Click="OpenPersonalTuningClick"/><StackPanel><TextBlock Text="个人方案" Style="{StaticResource Muted}"/><TextBlock x:Name="PersonalOverviewText" Text="读取中…" FontSize="20" Margin="0,6,0,0"/></StackPanel></DockPanel></Border>
          <UniformGrid Columns="2" Margin="0,0,0,12">
            <Border Style="{StaticResource Card}" Margin="0,0,6,0"><StackPanel><TextBlock Text="CPU" FontWeight="SemiBold"/><TextBlock x:Name="CpuTemperatureText" Text="—" FontSize="42" FontWeight="Light" Margin="0,18,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="6,0,0,0"><StackPanel><TextBlock Text="GPU" FontWeight="SemiBold"/><TextBlock x:Name="GpuTemperatureText" Text="—" FontSize="42" FontWeight="Light" Margin="0,18,0,0"/></StackPanel></Border>
          </UniformGrid>
          <UniformGrid Columns="3" Margin="0,0,0,12">
            <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="CPU 负载" Style="{StaticResource Muted}"/><TextBlock x:Name="CpuText" Text="—" Style="{StaticResource Metric}"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="4,0,4,0"><StackPanel><TextBlock Text="内存" Style="{StaticResource Muted}"/><TextBlock x:Name="MemoryText" Text="—" Style="{StaticResource Metric}"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel><TextBlock Text="电池" Style="{StaticResource Muted}"/><TextBlock x:Name="BatteryText" Text="—" Style="{StaticResource Metric}"/></StackPanel></Border>
          </UniformGrid>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="22,16"><UniformGrid Columns="2"><DockPanel Margin="0,0,22,0"><TextBlock x:Name="Fan1Text" Text="—" DockPanel.Dock="Right"/><TextBlock Text="风扇 1" Style="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel><DockPanel Margin="22,0,0,0"><TextBlock x:Name="Fan2Text" Text="—" DockPanel.Dock="Right"/><TextBlock Text="风扇 2" Style="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel></UniformGrid></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="22,16"><DockPanel><Button x:Name="ApplyPerformanceButton" Style="{StaticResource IconButton}" DockPanel.Dock="Right" Click="ApplyPerformanceClick" ToolTip="应用性能档" AutomationProperties.Name="应用性能档"><TextBlock Text="&#xE73E;" Style="{StaticResource Icon}"/></Button><ComboBox x:Name="DevicePerformanceChoice" Width="142" DockPanel.Dock="Right" AutomationProperties.Name="设备性能档"><ComboBoxItem Content="省电" Tag="194"/><ComboBoxItem Content="均衡" Tag="193"/><ComboBoxItem Content="性能" Tag="192"/><ComboBoxItem Content="极速" Tag="196"/></ComboBox><StackPanel VerticalAlignment="Center"><TextBlock Text="性能档"/><TextBlock x:Name="PerformanceStatusText" Style="{StaticResource Muted}"/></StackPanel></DockPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="CPU" FontWeight="SemiBold"/><TextBlock Text="100%" Style="{StaticResource Muted}" HorizontalAlignment="Right"/></DockPanel><Viewbox Stretch="Fill" Height="112" Margin="0,18,0,0"><Canvas Width="900" Height="100"><Line X1="0" X2="900" Y1="99" Y2="99" Stroke="#E8E8E8"/><Line X1="0" X2="900" Y1="50" Y2="50" Stroke="#F0F0F0"/><Polyline x:Name="HistoryLine" Stroke="{DynamicResource Accent}" StrokeThickness="2"/><TextBlock x:Name="HistoryEmptyText" Text="—" Foreground="#737373" Canvas.Left="440" Canvas.Top="40"/></Canvas></Viewbox></StackPanel></Border>
          <Expander x:Name="TuningExpander" Header="方案记录" Margin="0,18,0,0"><StackPanel><DockPanel Margin="0,10,0,10"><Button Style="{StaticResource IconButton}" DockPanel.Dock="Right" Click="ExportTuningClick" ToolTip="导出记录" AutomationProperties.Name="导出方案记录"><TextBlock Text="&#xE898;" Style="{StaticResource Icon}"/></Button><TextBlock x:Name="TuningStatusText" Style="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel><DataGrid x:Name="TuningTable" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="None" Background="White" BorderBrush="#E8E8E8" RowHeaderWidth="0" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="TuningSelectionChanged" ToolTip="选中两条记录进行比较" AutomationProperties.Name="方案记录"><DataGrid.Columns><DataGridTextColumn Header="方案" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="66"/><DataGridTextColumn Header="GPU" Binding="{Binding Gpu}" Width="66"/><DataGridTextColumn Header="风扇 1" Binding="{Binding Fan1}" Width="78"/><DataGridTextColumn Header="风扇 2" Binding="{Binding Fan2}" Width="78"/><DataGridTextColumn Header="负载" Binding="{Binding Load}" Width="60"/><DataGridTextColumn Header="时长" Binding="{Binding Duration}" Width="66"/></DataGrid.Columns></DataGrid><TextBlock x:Name="TuningComparisonText" Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Expander>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <DockPanel Margin="0,0,0,16"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Style="{StaticResource IconButton}" Click="ImportProfileClick" ToolTip="导入方案" AutomationProperties.Name="导入方案"><TextBlock Text="&#xE8B5;" Style="{StaticResource Icon}"/></Button><Button Style="{StaticResource IconButton}" Click="ExportProfileClick" ToolTip="导出方案" AutomationProperties.Name="导出方案"><TextBlock Text="&#xE898;" Style="{StaticResource Icon}"/></Button><Button x:Name="ApplyProfileButton" Style="{StaticResource IconButton}" Click="ApplyProfileClick" ToolTip="应用到设备" AutomationProperties.Name="应用方案"><TextBlock Text="&#xE73E;" Style="{StaticResource Icon}"/></Button><Button x:Name="StopProfileButton" Style="{StaticResource IconButton}" Click="StopProfileClick" ToolTip="停止方案" AutomationProperties.Name="停止方案" Visibility="Collapsed"><TextBlock Text="&#xE71A;" Style="{StaticResource Icon}"/></Button></StackPanel><StackPanel Orientation="Horizontal"><ComboBox x:Name="ProfileList" Width="228" SelectionChanged="ProfileChanged" AutomationProperties.Name="方案"/><Button Style="{StaticResource IconButton}" Click="NewProfileClick" ToolTip="新建方案" AutomationProperties.Name="新建方案"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}"/></Button><Button Style="{StaticResource IconButton}" Click="DeleteProfileClick" ToolTip="删除方案" AutomationProperties.Name="删除方案"><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}"/></Button></StackPanel></DockPanel>
          <DockPanel Margin="0,0,0,16"><ComboBox x:Name="ProfilePerformanceChoice" Width="140" DockPanel.Dock="Right" AutomationProperties.Name="方案性能档"><ComboBoxItem Content="保持性能档"/><ComboBoxItem Content="省电" Tag="194"/><ComboBoxItem Content="均衡" Tag="193"/><ComboBoxItem Content="性能" Tag="192"/><ComboBoxItem Content="极速" Tag="196"/></ComboBox><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="安静" Style="{StaticResource Muted}" VerticalAlignment="Center"/><Slider x:Name="BalanceSlider" Minimum="0" Maximum="100" Value="50" Width="210" Margin="14,0" IsSnapToTickEnabled="True" TickFrequency="5" SmallChange="5" LargeChange="10" IsEnabled="False" ValueChanged="BalanceChanged" ToolTip="仅调整风扇曲线，保持已选性能档" AutomationProperties.Name="安静与散热倾向"/><TextBlock Text="清凉" Style="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel></DockPanel>
          <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,16"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ReadDeviceCurveButton" Style="{StaticResource IconButton}" Click="ReadDeviceCurveClick" ToolTip="读取设备曲线" AutomationProperties.Name="读取设备曲线"><TextBlock Text="&#xE896;" Style="{StaticResource Icon}"/></Button><Button x:Name="SaveProfileButton" Style="{StaticResource IconButton}" Click="SaveProfileClick" ToolTip="保存 (Ctrl+S)" AutomationProperties.Name="保存方案"><TextBlock Text="&#xE74E;" Style="{StaticResource Icon}"/></Button></StackPanel><StackPanel Margin="0,0,16,0"><TextBlock Text="名称" Style="{StaticResource Muted}" Margin="0,0,0,6"/><TextBox x:Name="ProfileName" MaxLength="40" AutomationProperties.Name="方案名称"/></StackPanel></DockPanel></Border>
          <UniformGrid Columns="2">
            <Border Style="{StaticResource Card}" Margin="0,0,6,0" Padding="18"><StackPanel><TextBlock Text="CPU" FontWeight="SemiBold" Margin="0,0,0,20"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="206"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><Grid Margin="16,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><TextBlock Text="温度" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="速度值" Style="{StaticResource Muted}"/></Grid><StackPanel x:Name="CpuCurveEditor"/></StackPanel><StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><Viewbox Stretch="Fill" Height="120"><Canvas Width="400" Height="100"><Line X1="0" X2="400" Y1="99" Y2="99" Stroke="#E8E8E8"/><Line X1="0" X2="400" Y1="50" Y2="50" Stroke="#F0F0F0"/><Polyline x:Name="CpuCurveLine" Stroke="{DynamicResource Accent}" StrokeThickness="2"/></Canvas></Viewbox><DockPanel Margin="0,8,0,0"><TextBlock Text="100" DockPanel.Dock="Right" Style="{StaticResource Muted}"/><TextBlock Text="0" Style="{StaticResource Muted}"/></DockPanel></StackPanel></Grid></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="6,0,0,0" Padding="18"><StackPanel><TextBlock Text="GPU" FontWeight="SemiBold" Margin="0,0,0,20"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="206"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><Grid Margin="16,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><TextBlock Text="温度" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="速度值" Style="{StaticResource Muted}"/></Grid><StackPanel x:Name="GpuCurveEditor"/></StackPanel><StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><Viewbox Stretch="Fill" Height="120"><Canvas Width="400" Height="100"><Line X1="0" X2="400" Y1="99" Y2="99" Stroke="#E8E8E8"/><Line X1="0" X2="400" Y1="50" Y2="50" Stroke="#F0F0F0"/><Polyline x:Name="GpuCurveLine" Stroke="{DynamicResource Accent}" StrokeThickness="2"/></Canvas></Viewbox><DockPanel Margin="0,8,0,0"><TextBlock Text="100" DockPanel.Dock="Right" Style="{StaticResource Muted}"/><TextBlock Text="0" Style="{StaticResource Muted}"/></DockPanel></StackPanel></Grid></StackPanel></Border>
          </UniformGrid>
          <TextBlock x:Name="ProfileStatusText" Style="{StaticResource Muted}" Margin="0,14,0,0"/>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12"><DockPanel><TextBox x:Name="RefreshInterval" Width="64" DockPanel.Dock="Right" AutomationProperties.Name="刷新间隔（秒）"/><TextBlock Text="刷新间隔（秒）" VerticalAlignment="Center"/></DockPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12"><DockPanel><Button x:Name="ApplyPowerPlanButton" Style="{StaticResource IconButton}" DockPanel.Dock="Right" Click="ApplyPowerPlanClick" ToolTip="应用 Windows 电源计划" AutomationProperties.Name="应用 Windows 电源计划"><TextBlock Text="&#xE73E;" Style="{StaticResource Icon}"/></Button><ComboBox x:Name="PowerPlanChoice" Width="210" DockPanel.Dock="Right" DisplayMemberPath="FriendlyName" SelectedValuePath="SchemeGuid" AutomationProperties.Name="Windows 电源计划"/><TextBlock Text="Windows 电源计划" VerticalAlignment="Center"/></DockPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12"><Expander x:Name="CpuPolicyExpander" Header="CPU 策略"><StackPanel x:Name="CpuPolicyFields" Margin="0,16,0,0">
            <DockPanel Margin="0,0,0,18"><Button x:Name="ApplyCpuPolicyButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="ApplyCpuPolicyClick" ToolTip="应用 CPU 策略" AutomationProperties.Name="应用 CPU 策略"><TextBlock Text="&#xE73E;" Style="{StaticResource Icon}"/></Button><Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="RefreshCpuPolicyClick" ToolTip="刷新 CPU 策略" AutomationProperties.Name="刷新 CPU 策略"><TextBlock Text="&#xE72C;" Style="{StaticResource Icon}"/></Button><ComboBox x:Name="CpuPowerSourceChoice" Width="100" HorizontalAlignment="Left" SelectedIndex="0" SelectionChanged="CpuPowerSourceChanged" AutomationProperties.Name="CPU 策略供电来源"><ComboBoxItem Content="插电"/><ComboBoxItem Content="电池"/></ComboBox></DockPanel>
            <DockPanel Margin="0,0,0,16"><TextBlock Text="能效偏好" Width="140" VerticalAlignment="Center"/><TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=CpuEnergyPreference, Path=Value, StringFormat=F0}" Width="36" TextAlignment="Right" VerticalAlignment="Center"/><Slider x:Name="CpuEnergyPreference" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ToolTip="Windows EPP：0 优先响应，100 优先能效；不锁定频率" AutomationProperties.Name="CPU 能效偏好"/></DockPanel>
            <DockPanel Margin="0,0,0,16"><ComboBox x:Name="CpuBoostChoice" Width="160" DockPanel.Dock="Right" AutomationProperties.Name="CPU 睿频策略"><ComboBoxItem Content="关闭"/><ComboBoxItem Content="开启"/><ComboBoxItem Content="积极"/><ComboBoxItem Content="高效"/><ComboBoxItem Content="积极高效"/><ComboBoxItem Content="积极且有保障"/><ComboBoxItem Content="高效且有保障"/></ComboBox><TextBlock Text="睿频" VerticalAlignment="Center"/></DockPanel>
            <DockPanel Margin="0,0,0,16"><TextBox x:Name="CpuMaximumState" Width="80" DockPanel.Dock="Right" AutomationProperties.Name="CPU 性能上限百分比" ToolTip="50–100%；100 保留完整性能范围"/><TextBlock Text="性能上限 (%)" VerticalAlignment="Center"/></DockPanel>
            <DockPanel><TextBox x:Name="CpuMaximumFrequency" Width="80" DockPanel.Dock="Right" AutomationProperties.Name="CPU 频率上限 MHz" ToolTip="自动，或 800–5000 MHz。系统策略上限，不是锁频或超频"/><TextBlock Text="频率上限 (MHz)" VerticalAlignment="Center"/></DockPanel>
            <TextBlock x:Name="CpuPolicyStatus" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
          </StackPanel></Expander></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12"><DockPanel><CheckBox x:Name="CloseToTray" Content="保留在托盘" DockPanel.Dock="Right"/><TextBlock Text="关闭窗口" VerticalAlignment="Center"/></DockPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,16"><DockPanel><ComboBox x:Name="AccentChoice" Width="148" DockPanel.Dock="Right" AutomationProperties.Name="强调色"><ComboBoxItem Content="青绿" Tag="#63D7C5"/><ComboBoxItem Content="蓝色" Tag="#78A9FF"/><ComboBoxItem Content="紫色" Tag="#C29CFF"/></ComboBox><TextBlock Text="强调色" VerticalAlignment="Center"/></DockPanel></Border>
          <DockPanel Margin="0,0,0,24"><Button x:Name="SaveSettingsButton" Content="保存" Click="SaveSettingsClick" DockPanel.Dock="Right" Margin="0"/><TextBlock x:Name="SettingsStatusText" Style="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel>
          <Expander Header="设备与诊断"><StackPanel Margin="0,16,0,0"><TextBlock x:Name="IdentityText" Style="{StaticResource Muted}"/><TextBlock x:Name="TelemetryWarningText" Style="{StaticResource Muted}" Margin="0,12,0,0"/><TextBlock x:Name="FanDiagnosticText" Style="{StaticResource Muted}" Margin="0,12,0,0"/><TextBlock x:Name="ActionDiagnosticText" Style="{StaticResource Muted}" Margin="0,12,0,0"/><StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button Content="导出" Click="ExportDiagnosticClick"/><Button Content="退出" Click="ExitClick"/></StackPanel></StackPanel></Expander>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button x:Name="FanPreviewButton" Style="{StaticResource IconButton}" Click="FanPreviewClick" DockPanel.Dock="Right" ToolTip="刷新风扇状态 (F5)" AutomationProperties.Name="刷新风扇状态"><TextBlock Text="&#xE72C;" Style="{StaticResource Icon}"/></Button><Button x:Name="RecoverCurveButton" Style="{StaticResource IconButton}" DockPanel.Dock="Right" Visibility="Collapsed" Click="RecoverCurveClick" ToolTip="恢复未完成方案的原曲线与自动模式" AutomationProperties.Name="恢复未完成方案"><TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="#9A6700"/></Button><TextBlock x:Name="FanEnabledIcon" Text="&#xE73E;" Style="{StaticResource Icon}" DockPanel.Dock="Right" Foreground="#008573" Visibility="Collapsed" Margin="0,0,16,0" ToolTip="已启用" AutomationProperties.Name="自动模式已启用"/><StackPanel><TextBlock Text="自动模式" FontWeight="SemiBold"/><TextBlock x:Name="FanPreviewText" Text="未检查" Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></DockPanel><Button x:Name="ApplyAutomaticButton" Content="启用" Click="ApplyAutomaticClick" Width="96" HorizontalAlignment="Left" Margin="0,24,0,0" ToolTip="切换至原厂自动模式"/><TextBlock x:Name="FanActionText" Style="{StaticResource Muted}" Margin="0,14,0,0"/></StackPanel></Border>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel>
            <DockPanel><Button Content="刷新检查" DockPanel.Dock="Right" Click="RefreshPersonalClick"/><TextBlock Text="我的 GS66" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
            <TextBlock Text="先减少不必要的发热，再按需要调风扇。快捷方案调整插电 CPU 参数，保留睿频；风扇独立调节。" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,20"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <StackPanel Margin="0,0,20,14"><TextBlock Text="插电频率上限" Style="{StaticResource Muted}"/><TextBlock x:Name="PersonalFrequencyText" Text="—" FontSize="28" Margin="0,5,0,0"/></StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,0,14"><TextBlock Text="生效能效偏好" Style="{StaticResource Muted}"/><TextBlock x:Name="PersonalEppText" Text="—" FontSize="28" Margin="0,5,0,0"/><TextBlock x:Name="PersonalEppDetail" Style="{StaticResource Muted}" FontSize="12"/></StackPanel>
              <StackPanel Grid.Row="1"><TextBlock Text="微星保存的模式" Style="{StaticResource Muted}"/><TextBlock x:Name="PersonalVendorText" Text="未读取" FontSize="18" Margin="0,5,0,0"/></StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="实时硬件性能档" Style="{StaticResource Muted}"/><TextBlock x:Name="PersonalFirmwareText" Text="待启用硬件读数" FontSize="18" Margin="0,5,0,0"/></StackPanel>
            </Grid>
            <TextBlock x:Name="PersonalHealthText" TextWrapping="Wrap" Margin="0,18,0,0" Style="{StaticResource Muted}"/>
            <Button Content="打开 Dragon Center 检查保存模式" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OpenVendorScenarioClick"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel>
            <TextBlock Text="快捷切换" FontSize="18" FontWeight="SemiBold"/>
            <ComboBox x:Name="PersonalPresetChoice" DisplayMemberPath="Name" SelectionChanged="PersonalPresetChanged" AutomationProperties.Name="个人 CPU 方案" Margin="0,16,0,10"/>
            <TextBlock x:Name="PersonalPresetDescription" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
              <Button x:Name="PersonalApplyButton" Content="应用插电方案" Click="ApplyPersonalPresetClick" AutomationProperties.Name="应用个人 CPU 方案" ToolTip="同步基础计划和当前滑块的插电参数，独立回读后保存"/>
              <Button x:Name="PersonalUndoButton" Content="恢复上次设置" Click="UndoPersonalClick" IsEnabled="False" AutomationProperties.Name="恢复上次 CPU 设置" ToolTip="核对设置仍属于本次修改后恢复；保留外部改动" Margin="10,0,0,0"/>
              <Button Content="高级参数" Click="AdvancedPersonalClick" Margin="10,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="PersonalActionStatus" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel>
            <TextBlock Text="保存自己的组合" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="在高级参数中应用后，可把当前实际插电参数保存为个人方案，并从托盘切换。" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,14"/>
            <DockPanel><Button Content="保存当前参数" DockPanel.Dock="Right" Click="SavePersonalPresetClick" Margin="10,0,0,0"/><TextBox x:Name="PersonalPresetName" Text="我的轻声方案" MaxLength="40" AutomationProperties.Name="个人 CPU 方案名称"/></DockPanel>
            <Button x:Name="PersonalDeleteButton" Content="移除选中的自定义方案" HorizontalAlignment="Left" Click="DeletePersonalPresetClick" Margin="0,12,0,0" IsEnabled="False"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="风扇单独调节" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="频率和能效方案不会直接压低风扇。需要更安静时，可以从设备曲线生成一个略低速的草稿，核对后再应用；独立温度保护和恢复机制继续工作。" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,14"/>
            <Button Content="准备更轻声的曲线草稿" HorizontalAlignment="Left" Click="PrepareQuietFanClick"/>
          </StackPanel></Border>
        </StackPanel></ScrollViewer></TabItem>
      </TabControl>
    </Grid>
  </Grid>
</Window>
